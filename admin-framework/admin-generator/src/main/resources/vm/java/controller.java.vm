package ${packageName}.controller.${moduleName};

import dev.geo.admin.common.annotation.Log;
import dev.geo.admin.common.core.controller.BaseController;
import dev.geo.admin.common.core.model.ApiResult;
import dev.geo.admin.common.core.model.PageResult;
import dev.geo.admin.common.enums.BusinessType;
import dev.geo.admin.excel.core.ExcelService;
import ${packageName}.model.${moduleName}.entity.${ClassName};
import ${packageName}.model.${moduleName}.dto.${ClassName}PageReqDTO;
import ${packageName}.model.${moduleName}.dto.${ClassName}SaveDTO;
import ${packageName}.service.${moduleName}.I${ClassName}Service;
import jakarta.servlet.http.HttpServletResponse;
import lombok.RequiredArgsConstructor;
import org.springframework.security.access.prepost.PreAuthorize;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestController
@RequestMapping("/${moduleName}/${businessName}")
@RequiredArgsConstructor
public class ${ClassName}Controller extends BaseController {
    private final I${ClassName}Service service;
    private final ExcelService excelService;

    @GetMapping("/list")
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:list')")
#if($table.tree)
    public ApiResult<List<${ClassName}>> list(@Validated ${ClassName}PageReqDTO query) { return success(service.selectList(query)); }
#else
    public ApiResult<PageResult<${ClassName}>> list(@Validated ${ClassName}PageReqDTO query) { return success(service.selectPage(query)); }
#end

    @GetMapping("/{id}")
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:query')")
    public ApiResult<${ClassName}> get(@PathVariable ${pkColumn.javaType} id) { return success(service.getById(id)); }

    @PostMapping
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:add')")
    @Log(title = ${functionLabel}, businessType = BusinessType.INSERT)
    public ApiResult<${pkColumn.javaType}> create(@Validated(${ClassName}SaveDTO.Create.class) @RequestBody ${ClassName}SaveDTO request) { return ApiResult.success("操作成功", service.create(request)); }

    @PutMapping
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:edit')")
    @Log(title = ${functionLabel}, businessType = BusinessType.UPDATE)
    public ApiResult<Void> update(@Validated(${ClassName}SaveDTO.Update.class) @RequestBody ${ClassName}SaveDTO request) { service.update(request); return success(); }

    @DeleteMapping("/{ids}")
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:remove')")
    @Log(title = ${functionLabel}, businessType = BusinessType.DELETE)
    public ApiResult<Void> delete(@PathVariable List<${pkColumn.javaType}> ids) { service.delete(ids); return success(); }

    @PostMapping("/export")
    @PreAuthorize("@se.hasPermission('${permissionPrefix}:export')")
    @Log(title = ${functionLabel}, businessType = BusinessType.EXPORT)
    public void export(HttpServletResponse response, @Validated ${ClassName}PageReqDTO query) {
        excelService.exportExcel(response, service.selectList(query), ${ClassName}.class, ${functionLabel});
    }
}
