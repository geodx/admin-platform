-- 当前 admin-platform 菜单结构。先确认父菜单，再执行；执行后为业务角色分配菜单权限。
INSERT INTO sys_menu (menu_name, parent_id, `order`, path, component, route_name, menu_type, hide_in_menu, keep_alive, status, perms, create_time)
SELECT '${functionSql}', $parentMenuId, 1, '${businessName}', 'sys/${moduleName}/${businessName}/index', '${ClassName}', 'menu', 0, 1, 1, '${permissionPrefix}:list', NOW()
WHERE NOT EXISTS (SELECT 1 FROM sys_menu WHERE perms = '${permissionPrefix}:list');
SET @parentId = (SELECT id FROM sys_menu WHERE perms = '${permissionPrefix}:list' ORDER BY id LIMIT 1);
#foreach($action in ['query', 'add', 'edit', 'remove', 'export'])
INSERT INTO sys_menu (menu_name, parent_id, `order`, path, menu_type, hide_in_menu, status, perms, create_time)
SELECT '${functionSql} ${action}', @parentId, $foreach.count, '', 'button', 1, 1, '${permissionPrefix}:${action}', NOW()
WHERE NOT EXISTS (SELECT 1 FROM sys_menu WHERE perms = '${permissionPrefix}:${action}');
#end
