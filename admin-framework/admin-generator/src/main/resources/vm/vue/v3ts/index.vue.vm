#parse('vm/vue/v3ts/control.vm')
<script setup lang="ts">
import { computed, nextTick, onBeforeUnmount, onMounted, ref, watch } from 'vue';
import { ElMessage, ElMessageBox, ElTableColumn } from 'element-plus';
import type { FormInstance, FormRules } from 'element-plus';
import type { ${ClassName}, ${ClassName}QueryParams, ${ClassName}SaveParams } from '@/types/base/api/${moduleName}/${businessName}';
import { list${BusinessName}, get${BusinessName}, add${BusinessName}, update${BusinessName}, del${BusinessName}, export${BusinessName} } from '@/api/${moduleName}/${businessName}';
import { downloadFileFromBlob } from '@/utils/download';
#if($hasUpload)
import { FileUpload } from '@/components/upload';
#end
#if($hasEditor)
import { VbenTiptap } from '@/components/tiptap';
import type { ImageUploadOptions } from '@/components/tiptap';
import { uploadFile, resolveFileUrl } from '@/api/common/file';
#end
#if($dictTypes.size() > 0)
import { useDict } from '@/utils/dict';
const dicts = useDict(#foreach($dict in $dictTypes)'$dict'#if($foreach.hasNext), #end#end);
#end
#if($genView)
import DetailView from './view.vue';
const detailRef = ref<InstanceType<typeof DetailView>>();
#end

defineOptions({ name: '${ClassName}' });
const Column = ElTableColumn<${ClassName}>;
const title = ${functionLabel};
const labels = {
#foreach($column in $columns)
  ${column.javaField}: ${column.labelLiteral},
#end
};
#if($table.sub)
const childLabels = {
#foreach($column in $subTable.columns)
  ${column.javaField}: ${column.labelLiteral},
#end
};
#end
const rows = ref<${ClassName}[]>([]);
const selected = ref<${ClassName}[]>([]);
const query = ref<${ClassName}QueryParams>({ pageNum: 1, pageSize: 10 });
const total = ref(0), loading = ref(false), saving = ref(false), exporting = ref(false);
const open = ref(false), editing = ref(false);
const formRef = ref<FormInstance>();
const form = ref<${ClassName}SaveParams>({});
#if($hasUpload || $hasEditor)
const uploadingFields = ref(new Set<string>());
function setUploading(field: string, value: boolean): void {
  if (value) uploadingFields.value.add(field); else uploadingFields.value.delete(field);
}
const uploading = computed(() => uploadingFields.value.size > 0);
#else
const uploading = ref(false);
#end
#if($hasEditor)
let editorUploadId = 0;
const editorRequests = new Set<AbortController>();
const editorImageUpload: ImageUploadOptions = {
  accept: '.jpg,.jpeg,.png,.gif,.bmp', maxSize: 10 * 1024 * 1024,
  onUploadError: () => ElMessage.error('图片上传失败，请重试'),
  async upload(file, onProgress) {
    const key = 'editor-' + ++editorUploadId;
    const controller = new AbortController(); editorRequests.add(controller); setUploading(key, true);
    try { const result = await uploadFile(file, { signal: controller.signal, onProgress }); return resolveFileUrl(result.fileName); }
    finally { editorRequests.delete(controller); setUploading(key, false); }
  },
};
function cancelEditorUploads(): void { for (const controller of editorRequests) controller.abort(); editorRequests.clear(); }
watch(open, value => { if (!value) cancelEditorUploads(); });
onBeforeUnmount(cancelEditorUploads);
#end
const rules = computed<FormRules>(() => ({
#foreach($column in $table.saveColumns)
#if($column.required && !$column.pk)
  ${column.javaField}: [{ required: editing.value ? $column.edit : $column.insert, message: labels.${column.javaField} + '不能为空', trigger: 'change' }],
#elseif($column.pk && !$column.increment)
  ${column.javaField}: [{ required: true, message: '请输入主键', trigger: 'blur' }],
#end
#end
}));
let listRequest = 0, editRequest = 0;
async function load(): Promise<void> {
  const current = ++listRequest; loading.value = true;
  try {
    const result = await list${BusinessName}(query.value);
    if (current !== listRequest) return;
#if($table.tree)
    rows.value = result;
#else
    rows.value = result.records; total.value = result.total;
#end
    selected.value = [];
  } finally { if (current === listRequest) loading.value = false; }
}
function search(): void { query.value.pageNum = 1; void load(); }
function reset(): void { query.value = { pageNum: 1, pageSize: 10 }; void load(); }
#if($table.tree)
type TreeRow = ${ClassName} & { children: TreeRow[] };
function asTree(items: ${ClassName}[]): TreeRow[] {
  const map = new Map(items.map(item => [item.${treeCode}, { ...item, children: [] as TreeRow[] }]));
  const roots: TreeRow[] = [];
  for (const node of map.values()) {
    const parent = node.${treeParentCode} == null ? undefined : map.get(node.${treeParentCode});
    if (parent && parent !== node) parent.children.push(node); else roots.push(node);
  }
  return roots;
}
const treeRows = computed(() => asTree(rows.value));
const parentOptions = ref<TreeRow[]>([]);
#end
async function edit(row?: ${ClassName}): Promise<void> {
  const current = ++editRequest;
  const entity = row ? await get${BusinessName}(row.${pkColumn.javaField}) : undefined;
#if($table.tree)
  const parents = await list${BusinessName}();
#end
  if (current !== editRequest) return;
  editing.value = !!entity;
  form.value = {
#foreach($column in $table.saveColumns)
    ${column.javaField}: entity?.${column.javaField} ?? #if($table.tree && $column.javaField == $treeParentCode)#if($column.tsType == 'number')0#else'0'#end#{else}null#end,
#end
#if($table.sub)
    ${subclassName}List: entity?.${subclassName}List?.map(child => ({
#foreach($column in $subTable.saveColumns)
      ${column.javaField}: child.${column.javaField},
#end
    })) ?? [],
#end
  };
#if($table.tree)
  parentOptions.value = asTree(parents);
#end
  open.value = true; await nextTick(); formRef.value?.clearValidate();
}
async function save(): Promise<void> {
  if (uploading.value || !(await formRef.value?.validate().catch(() => false))) return;
  saving.value = true;
  try {
    if (editing.value) await update${BusinessName}(form.value); else await add${BusinessName}(form.value);
    ElMessage.success('保存成功'); open.value = false; await load();
  } finally { saving.value = false; }
}
async function remove(row?: ${ClassName}): Promise<void> {
  const ids = (row ? [row] : selected.value).map(item => item.${pkColumn.javaField});
  if (!ids.length) return;
  try { await ElMessageBox.confirm('确认删除选中的数据？', '提示', { type: 'warning' }); } catch { return; }
  await del${BusinessName}(ids); ElMessage.success('删除成功'); await load();
}
async function exportData(): Promise<void> {
  exporting.value = true;
  try { downloadFileFromBlob({ source: await export${BusinessName}(query.value), fileName: title + '.xlsx' }); }
  finally { exporting.value = false; }
}
onMounted(() => void load());
onBeforeUnmount(() => { listRequest++; editRequest++; });
</script>

<template>
  <div class="p-4">
    <el-form :model="query" inline @submit.prevent="search">
#foreach($column in $table.queryColumns)
      <el-form-item :label="labels.${column.javaField}">
#if($column.queryType == 'BETWEEN')
#control($column "query.${column.javaField}Start" true)
        <span class="mx-2">至</span>
#control($column "query.${column.javaField}End" true)
#else
#control($column "query.${column.javaField}" true)
#end
      </el-form-item>
#end
      <el-form-item><el-button type="primary" native-type="submit">查询</el-button><el-button @click="reset">重置</el-button></el-form-item>
    </el-form>
    <div class="mb-4 flex gap-2">
      <el-button v-access:code="['${permissionPrefix}:add']" type="primary" @click="edit()">新增</el-button>
      <el-button v-access:code="['${permissionPrefix}:remove']" type="danger" plain :disabled="!selected.length" @click="remove()">删除</el-button>
      <el-button v-access:code="['${permissionPrefix}:export']" :loading="exporting" @click="exportData">导出</el-button>
    </div>
    <el-table v-loading="loading" :data="#if($table.tree)treeRows#{else}rows#end" row-key="${pkColumn.javaField}" @selection-change="value => selected = value">
      <Column type="selection" width="48" />
#foreach($column in $columns)
#if($column.list)
#if($column.dictType && $column.dictType != '')
      <Column prop="${column.javaField}" :label="labels.${column.javaField}" min-width="130">
        <template #default="{ row }">{{ dicts['${column.dictType}'].value.filter(item => String(row.${column.javaField} ?? '').split(',').includes(item.value)).map(item => item.label).join('、') || String(row.${column.javaField} ?? '—') }}</template>
      </Column>
#else
      <Column prop="${column.javaField}" :label="labels.${column.javaField}" min-width="130" show-overflow-tooltip />
#end
#end
#end
      <Column label="操作" width="200" fixed="right">
        <template #default="{ row }">
#if($genView)
          <el-button v-access:code="['${permissionPrefix}:query']" link type="primary" @click="detailRef?.show(row.${pkColumn.javaField})">详情</el-button>
#end
          <el-button v-access:code="['${permissionPrefix}:edit']" link type="primary" @click="edit(row)">编辑</el-button>
          <el-button v-access:code="['${permissionPrefix}:remove']" link type="danger" @click="remove(row)">删除</el-button>
        </template>
      </Column>
    </el-table>
#if(!$table.tree)
    <el-pagination v-model:current-page="query.pageNum" v-model:page-size="query.pageSize" :total="total" :page-sizes="[10, 20, 50, 100]" layout="total, sizes, prev, pager, next" class="mt-4 justify-end" @change="load" />
#end
    <el-dialog v-model="open" :title="(editing ? '修改' : '新增') + title" width="min(1000px, 95vw)" destroy-on-close :close-on-click-modal="false" :close-on-press-escape="!saving" :show-close="!saving">
      <el-form ref="formRef" :model="form" :rules="rules" label-width="110px" :disabled="saving">
        <el-row :gutter="20">
#foreach($column in $table.saveColumns)
#if(!$column.pk || !$column.increment)
          <el-col :span="$colSpan" v-if="#if($column.pk)true#else(editing ? $column.edit : $column.insert)#end">
            <el-form-item :label="labels.${column.javaField}" prop="${column.javaField}">
#if($column.pk)
#if($column.tsType == 'number')
              <el-input-number v-model="form.${column.javaField}" :disabled="editing" />
#else
              <el-input v-model="form.${column.javaField}" :disabled="editing" />
#end
#elseif($table.tree && $column.javaField == $treeParentCode)
              <el-tree-select v-model="form.${column.javaField}" :data="[{ ${treeCode}: #if($column.tsType == 'number')0#else'0'#end, ${treeName}: '顶级', children: parentOptions }]" node-key="${treeCode}" :props="{ label: '${treeName}', children: 'children' }" check-strictly default-expand-all />
#else
#control($column "form.${column.javaField}" false)
#end
            </el-form-item>
          </el-col>
#end
#end
        </el-row>
#if($table.sub)
        <el-divider>明细</el-divider>
        <el-button :disabled="uploading" @click="(form.${subclassName}List ??= []).push({})">添加明细</el-button>
        <el-card v-for="(child, index) in form.${subclassName}List" :key="index" class="mt-3">
          <el-row :gutter="20">
#foreach($column in $subTable.saveColumns)
#if($column.javaField != $subFk.javaField && (!$column.pk || !$column.increment))
            <el-col :span="12"><el-form-item :label="childLabels.${column.javaField}" :prop="'${subclassName}List.' + index + '.${column.javaField}'" :rules="[{ required: $column.required, message: '此项不能为空', trigger: 'change' }]">
#control($column "child.${column.javaField}" false)
            </el-form-item></el-col>
#end
#end
          </el-row>
          <el-button type="danger" plain :disabled="uploading" @click="form.${subclassName}List?.splice(index, 1)">删除明细</el-button>
        </el-card>
#end
      </el-form>
      <template #footer><el-button :disabled="saving" @click="open = false">取消</el-button><el-button type="primary" :loading="saving" :disabled="uploading" @click="save">保存</el-button></template>
    </el-dialog>
#if($genView)
    <DetailView ref="detailRef" />
#end
  </div>
</template>
