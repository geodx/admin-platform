<script setup lang="ts">
import { onBeforeUnmount, ref } from 'vue';
import type { ${ClassName} } from '@/types/base/api/${moduleName}/${businessName}';
import { get${BusinessName} } from '@/api/${moduleName}/${businessName}';
const open = ref(false), loading = ref(false);
const data = ref<${ClassName}>();
const title = ${functionLabel} + '详情';
const labels = {
#foreach($column in $columns)
  ${column.javaField}: ${column.labelLiteral},
#end
};
let requestId = 0;
async function show(id: ${pkColumn.tsType}): Promise<void> {
  const current = ++requestId; data.value = undefined; open.value = true; loading.value = true;
  try { const result = await get${BusinessName}(id); if (current === requestId) data.value = result; }
  finally { if (current === requestId) loading.value = false; }
}
onBeforeUnmount(() => requestId++);
defineExpose({ show });
</script>
<template>
  <el-dialog v-model="open" :title="title" width="min(900px, 95vw)" append-to-body>
    <div v-loading="loading">
      <el-descriptions v-if="data" :column="2" border>
#foreach($column in $columns)
        <el-descriptions-item :label="labels.${column.javaField}">{{ data.${column.javaField} ?? '—' }}</el-descriptions-item>
#end
      </el-descriptions>
#if($table.sub)
      <el-table :data="data?.${subclassName}List ?? []" class="mt-4">
#foreach($column in $subTable.columns)
        <el-table-column prop="${column.javaField}" label="${column.javaField}" />
#end
      </el-table>
#end
    </div>
  </el-dialog>
</template>
