<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.geo.admin.quartz.mapper.SysJobLogMapper">
    <resultMap id="SysJobLogResult" type="dev.geo.admin.quartz.model.SysJobLog">
        <id property="id" column="id"/>
        <result property="jobName" column="job_name"/>
        <result property="jobGroup" column="job_group"/>
        <result property="invokeTarget" column="invoke_target"/>
        <result property="jobMessage" column="job_message"/>
        <result property="status" column="status"/>
        <result property="exceptionInfo" column="exception_info"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="createTime" column="create_time"/>
    </resultMap>
    <sql id="columns">
        select id, job_name, job_group, invoke_target, job_message, status,
               exception_info, start_time, end_time, create_time from sys_job_log
    </sql>
    <sql id="filters">
        <where>
            <if test="query.jobName != null and query.jobName != ''">
                and job_name like concat('%', #{query.jobName}, '%')
            </if>
            <if test="query.jobGroup != null and query.jobGroup != ''">
                and job_group = #{query.jobGroup}
            </if>
            <if test="query.status != null and query.status != ''">
                and status = #{query.status}
            </if>
            <if test="query.invokeTarget != null and query.invokeTarget != ''">
                and invoke_target like concat('%', #{query.invokeTarget}, '%')
            </if>
            <if test="query.params.beginTime != null and query.params.beginTime != ''">
                and cast(create_time as date) &gt;= cast(#{query.params.beginTime} as date)
            </if>
            <if test="query.params.endTime != null and query.params.endTime != ''">
                and cast(create_time as date) &lt;= cast(#{query.params.endTime} as date)
            </if>
        </where>
    </sql>
    <select id="selectJobLogPage" resultMap="SysJobLogResult">
        <include refid="columns"/><include refid="filters"/> order by create_time desc, id desc
    </select>
    <select id="selectJobLogList" resultMap="SysJobLogResult">
        <include refid="columns"/><include refid="filters"/> order by create_time desc, id desc
    </select>
    <select id="selectJobLogById" resultMap="SysJobLogResult">
        <include refid="columns"/> where id = #{id}
    </select>
    <delete id="deleteJobLogById">
        delete from sys_job_log where id = #{id}
    </delete>
    <delete id="deleteJobLogByIds">
        delete from sys_job_log where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
    <update id="cleanJobLog">
        truncate table sys_job_log
    </update>
    <insert id="insertJobLog" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into sys_job_log
            (job_name, job_group, invoke_target, job_message, status, exception_info,
             start_time, end_time, create_time)
        values
            (#{jobName}, #{jobGroup}, #{invokeTarget}, #{jobMessage}, #{status}, #{exceptionInfo},
             #{startTime}, #{endTime}, current_timestamp(3))
    </insert>
</mapper>
